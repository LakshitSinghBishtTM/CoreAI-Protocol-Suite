# CaiPS configuration template. Only variables the code actually reads are listed.
# Copy to .env, fill in real values, never commit it. The server does NOT load .env
# itself: run `set -a; source .env; set +a` first, or use `docker run --env-file .env`.

# --- Required ---
# Secret used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ENVIRONMENT=development

# --- Model providers (set the ones you use; unset providers are skipped) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=

# --- Storage ---
# Default is SQLite. Leave DATABASE_URL empty to use it.
# DB_PATH sets the SQLite file location.
# For Postgres install the extra (pip install -e .[postgres]) and set, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/coreai
DATABASE_URL=
DB_PATH=

# --- Reliability (all optional; defaults shown) ---
# REQUEST_TIMEOUT_SECONDS=60          per-attempt timeout for one provider call
# PROVIDER_TIMEOUTS=deepseek=120      per-provider overrides, name=seconds,...
# REQUEST_DEADLINE_SECONDS=120        total budget across retries and failovers ("none" = unlimited)
# ENABLE_FAILOVER=true                try the next provider when one fails
# MAX_ATTEMPTS_BEFORE_FAILOVER=2      tries on one provider while others remain
# CIRCUIT_FAILURE_THRESHOLD=5         consecutive failures that stop traffic to a provider
# CIRCUIT_RESET_SECONDS=30            how long before a stopped provider is probed again
# CACHE_MAX_ENTRIES=1000              size limit of the in-memory response cache

# --- Optional ---
JWT_EXPIRY_MINS=60
WEBHOOK_SIGNING_SECRET=
