# CaiPS configuration template. Only variables the code actually reads are listed.
# Copy to .env, fill in real values, never commit it. The server does NOT load .env
# itself: run `set -a; source .env; set +a` first, or use `docker run --env-file .env`.

# --- Required ---
# Secret used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ENVIRONMENT=development

# --- Model providers (set the ones you use; unset providers are skipped) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=

# --- Storage ---
# Default is SQLite. Leave DATABASE_URL empty to use it.
# DB_PATH sets the SQLite file location.
# For Postgres install the extra (pip install -e .[postgres]) and set, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/coreai
DATABASE_URL=
DB_PATH=

# --- Optional ---
JWT_EXPIRY_MINS=60
WEBHOOK_SIGNING_SECRET=
